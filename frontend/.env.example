# Salin file ini menjadi .env (jangan commit .env berisi secret).
# Untuk GitHub Pages, isi nilai yang sama di: GitHub repo -> Settings ->
# Secrets and variables -> Actions -> New repository secret (VITE_FIREBASE_*).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (opsional tapi direkomendasikan untuk produksi).
# reCAPTCHA v3 SITE KEY dari: Firebase Console -> App Check -> Register app
# (atau Google Cloud -> reCAPTCHA). BUKAN secret key — site key memang publik.
# Jika dikosongkan, App Check nonaktif (aman untuk dev/CI).
VITE_FIREBASE_APPCHECK_SITE_KEY=
