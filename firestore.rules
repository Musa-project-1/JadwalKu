rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@jadwalkampus.app";
    }

    match /jadwal/{doc} {
      // "archived" ikut boleh dibaca — dipakai fitur arsip TA di sisi mahasiswa
      // (WeeklySchedule: dropdown tahun ajaran lampau).
      allow read: if isAdmin() || resource.data.status in ["published", "archived"];
      allow write: if isAdmin();
    }

    match /mataKuliah/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ujian/{doc} {
      allow read: if isAdmin() || resource.data.status in ["published", "archived"];
      allow write: if isAdmin();
    }

    match /prodi/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /libur/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /riwayat/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /errorLog/{doc} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /tugasProdi/{doc} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
