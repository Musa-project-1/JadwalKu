rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@jadwalkampus.app";
    }

    // Admin/registrar kampus — saat ini dikendalikan admin global.
    // Untuk multi-tenant penuh, pisahkan per kampus lewat koleksi `adminUsers`.
    function isCampusStaff(kampusId) {
      return isAdmin() || (request.auth != null
        && request.auth.token.kampusId == kampusId);
    }

    match /kampus/{doc} {
      // Konfigurasi kampus boleh dibaca publik (diperlukan oleh mahasiswa
      // untuk memuat prodi/tipe kelas/ruang yang benar).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminUsers/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /jadwal/{doc} {
      // "archived" ikut boleh dibaca — dipakai fitur arsip TA di sisi mahasiswa
      // (WeeklySchedule: dropdown tahun ajaran lampau).
      allow read: if isAdmin() || resource.data.status in ["published", "archived"];
      allow write: if isAdmin();
    }

    match /mataKuliah/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ujian/{doc} {
      allow read: if isAdmin() || resource.data.status in ["published", "archived"];
      allow write: if isAdmin();
    }

    match /prodi/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /libur/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /riwayat/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /errorLog/{doc} {
      // Hanya pengguna terautentikasi yang boleh menulis log error,
      // untuk mencegah spam/DoS & log poisoning oleh anonim.
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tugasProdi/{doc} {
      allow read: if true;
      // Tulis hanya boleh oleh admin. Sebelumnya open (if true) —
      // siapa pun, termasuk anonim, bisa membuat/mengubah/menghapus.
      allow write: if isAdmin();
    }

    match /fakultas/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
